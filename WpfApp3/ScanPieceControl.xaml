<UserControl x:Class="WpfApp3.ScanPieceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp3"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Background="LightYellow">
        <StackPanel>
            <TextBlock Text="Scanner ou confirmer la pièce" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="ScanInput" Height="30" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button Content="OK" Width="80" Margin="5" Command="{Binding ConfirmScanCommand}"/>
                <Button Content="Annuler" Width="80" Margin="5" Command="{Binding CancelScanCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
